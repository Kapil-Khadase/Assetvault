# AssetVault Environment Configuration Template
# Copy this file to .env and configure your environment-specific secrets
# DO NOT COMMIT YOUR REAL .env FILE TO VERSION CONTROL

# ----------------- SECURITY & CRYPTOGRAPHY ----------------- #
# Application Secret Key for Session & Cryptographic Operations (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=replace-with-a-secure-random-32-byte-hex-string

# JWT Secret Key for Token Signing (Optional, defaults to SECRET_KEY if unset)
JWT_SECRET_KEY=replace-with-a-secure-random-jwt-key

# ----------------- ENVIRONMENT & APPLICATION ----------------- #
# Environment Setting: development | production
FLASK_ENV=development

# Debug Mode: 0 for False (Production), 1 for True (Development)
FLASK_DEBUG=0

# Database Connection (Defaults to SQLite at backend/assetvault.db)
DATABASE_URL=backend/assetvault.db

# ----------------- EXTERNAL MARKET DATA ----------------- #
# External Commodity Market Rate API Key (e.g. MetalpriceAPI or GoldAPI)
# Kept strictly server-side; never exposed to frontend clients
MARKET_API_KEY=

# ----------------- DEMO & SEEDING CONFIGURATION ----------------- #
# Set ALLOW_DEMO_LOGIN=0 in production to disable pre-configured sandbox demo login
ALLOW_DEMO_LOGIN=1

# Seed sample demo assets and portfolio items on first database initialization
SEED_DEMO_DATA=1

# Configurable demo credentials for development/testing environments
DEMO_USER_EMAIL=kapil@example.com
DEMO_USER_PASSWORD=demo123
